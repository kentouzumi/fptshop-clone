// ============================================================
// SCHEMA PRISMA - WEBSITE THƯƠNG MẠI ĐIỆN TỬ (kiểu FPT Shop)
// Database: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 1. NGƯỜI DÙNG & TÀI KHOẢN
// ============================================================

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  fullName      String
  avatarUrl     String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  phoneVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses       Address[]
  orders          Order[]
  cart            Cart?
  wishlist        WishlistItem[]
  reviews         Review[]
  reviewVotes     ReviewVote[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  loyaltyAccount  LoyaltyAccount?
  tradeInRequests TradeInRequest[]
  sessions        Session[]
  auditLogs       AuditLog[]

  @@index([role])
}

// Dùng nếu tự làm auth (không dùng Supabase/Auth0)
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Mã OTP đăng nhập bằng số điện thoại (chưa gắn nhà cung cấp SMS thật)
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  recipientName String
  phone        String
  province     String
  district     String
  ward         String
  streetDetail String
  isDefault    Boolean @default(false)
  label        String? // "Nhà riêng", "Công ty"...

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// Tích điểm thành viên
enum LoyaltyTier {
  MEMBER
  SILVER
  GOLD
  DIAMOND
}

model LoyaltyAccount {
  id        String      @id @default(cuid())
  userId    String      @unique
  points    Int         @default(0)
  tier      LoyaltyTier @default(MEMBER)
  updatedAt DateTime    @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointTransactions LoyaltyTransaction[]
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  type      LoyaltyTxnType
  points    Int
  orderId   String?
  note      String?
  createdAt DateTime       @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id])

  @@index([accountId])
}

// ============================================================
// 2. DANH MỤC, THƯƠNG HIỆU, SẢN PHẨM
// ============================================================

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  imageUrl String?
  sortOrder Int       @default(0)
  isActive Boolean    @default(true)

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  isActive Boolean   @default(true)

  products Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

model Product {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String        @db.Text
  categoryId    String
  brandId       String?
  status        ProductStatus @default(DRAFT)
  basePrice     Decimal       @db.Decimal(12, 0)
  isFeatured    Boolean       @default(false)
  metaTitle     String?
  metaDesc      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   Category           @relation(fields: [categoryId], references: [id])
  brand      Brand?             @relation(fields: [brandId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  attributes ProductAttribute[]
  reviews    Review[]
  wishlist   WishlistItem[]
  relatedTo  ProductRelation[]  @relation("BaseProduct")
  relatedBy  ProductRelation[]  @relation("RelatedProduct")

  @@index([categoryId])
  @@index([brandId])
  // Với Postgres, tạo full-text search index riêng bằng raw SQL migration:
  // CREATE INDEX product_name_search_idx ON "Product" USING GIN (to_tsvector('simple', name));
}

// Biến thể: màu sắc, dung lượng RAM/ROM... mỗi biến thể có SKU/giá/tồn kho riêng
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique
  color      String?
  storage    String?  // "128GB", "8GB RAM"...
  price      Decimal  @db.Decimal(12, 0)
  compareAtPrice Decimal? @db.Decimal(12, 0) // giá gạch ngang
  weightGram Int?
  barcode    String?
  isActive   Boolean  @default(true)

  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  inventories    Inventory[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  tradeInDevices TradeInRequest[] @relation("TradeInDevice")

  @@index([productId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  sortOrder Int             @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
}

// Thông số kỹ thuật dạng key-value (CPU, màn hình, pin...)
model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  groupName String  // "Màn hình", "Camera", "Pin"...
  attrName  String  // "Kích thước màn hình"
  attrValue String  // "6.7 inch"
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Sản phẩm liên quan / gợi ý mua kèm
model ProductRelation {
  id               String @id @default(cuid())
  baseProductId    String
  relatedProductId String
  type             String @default("RELATED") // RELATED, UPSELL, ACCESSORY

  baseProduct    Product @relation("BaseProduct", fields: [baseProductId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([baseProductId, relatedProductId])
}

// ============================================================
// 3. CỬA HÀNG & TỒN KHO
// ============================================================

model Store {
  id         String   @id @default(cuid())
  name       String
  province   String
  district   String
  address    String
  latitude   Float?
  longitude  Float?
  phone      String?
  openHours  String?  // "8:00 - 22:00"
  isActive   Boolean  @default(true)

  inventories Inventory[]
  orders      Order[]     @relation("PickupStore")
}

model Inventory {
  id        String @id @default(cuid())
  storeId   String
  variantId String
  quantity  Int    @default(0)
  reserved  Int    @default(0) // đã đặt nhưng chưa xuất kho

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantId])
  @@index([variantId])
}

// ============================================================
// 4. GIỎ HÀNG
// ============================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

// ============================================================
// 5. ĐƠN HÀNG & THANH TOÁN
// ============================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum DeliveryMethod {
  HOME_DELIVERY
  STORE_PICKUP
}

model Order {
  id             String         @id @default(cuid())
  code           String         @unique // mã đơn hàng hiển thị cho khách
  userId         String
  addressId      String?
  pickupStoreId  String?
  deliveryMethod DeliveryMethod
  status         OrderStatus    @default(PENDING)
  subtotal       Decimal        @db.Decimal(14, 0)
  discountTotal  Decimal        @default(0) @db.Decimal(14, 0)
  shippingFee    Decimal        @default(0) @db.Decimal(14, 0)
  grandTotal     Decimal        @db.Decimal(14, 0)
  couponId       String?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user            User                 @relation(fields: [userId], references: [id])
  address         Address?             @relation(fields: [addressId], references: [id])
  pickupStore     Store?               @relation("PickupStore", fields: [pickupStoreId], references: [id])
  coupon          Coupon?              @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  shipment        Shipment?
  statusHistory   OrderStatusHistory[]
  loyaltyTxns     LoyaltyTransaction[]
  installmentPlan InstallmentPlan?
  reviews         Review[]

  @@index([userId])
  @@index([status])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String
  productName  String  // snapshot tên SP tại thời điểm mua
  variantLabel String  // snapshot "Đen / 128GB"
  unitPrice    Decimal @db.Decimal(12, 0)
  quantity     Int
  lineTotal    Decimal @db.Decimal(14, 0)
  warrantyId   String?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
  warranty Warranty?     @relation(fields: [warrantyId], references: [id])

  @@index([orderId])
}

enum PaymentMethod {
  COD
  BANK_CARD
  VISA_MASTERCARD
  E_WALLET
  INSTALLMENT
  BANK_TRANSFER
  VNPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(14, 0)
  transactionRef String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Trả góp qua công ty tài chính
model InstallmentPlan {
  id            String  @id @default(cuid())
  orderId       String  @unique
  provider      String  // "Home Credit", "FE Credit"...
  months        Int
  downPayment   Decimal @db.Decimal(14, 0)
  monthlyAmount Decimal @db.Decimal(14, 0)
  interestRate  Decimal @db.Decimal(5, 2)
  approved      Boolean @default(false)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  carrier        String?        // đơn vị vận chuyển, hoặc "Nội bộ" (giao trong 20km)
  trackingCode   String?
  status         ShipmentStatus @default(PREPARING)
  estimatedDate  DateTime?
  deliveredAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============================================================
// 6. KHUYẾN MÃI / MÃ GIẢM GIÁ
// ============================================================

enum CouponType {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(12, 0) // % hoặc số tiền
  minOrderValue Decimal   @default(0) @db.Decimal(14, 0)
  maxDiscount  Decimal?   @db.Decimal(12, 0)
  usageLimit   Int?
  usedCount    Int        @default(0)
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean    @default(true)

  orders Order[]
}

// Chương trình khuyến mãi hiển thị trên site (banner, flash sale...)
model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?
  bannerUrl   String?
  linkUrl     String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
}

// ============================================================
// 7. ĐÁNH GIÁ SẢN PHẨM
// ============================================================

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  orderId    String?  // để xác thực "đã mua hàng"
  rating     Int      // 1-5
  title      String?
  content    String   @db.Text
  isVerified Boolean  @default(false)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id])
  order   Order?       @relation(fields: [orderId], references: [id])
  images  ReviewImage[]
  votes   ReviewVote[]

  @@index([productId])
  @@unique([productId, userId])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewVote {
  id       String  @id @default(cuid())
  reviewId String
  userId   String
  isHelpful Boolean

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
}

// ============================================================
// 8. YÊU THÍCH / WISHLIST
// ============================================================

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ============================================================
// 9. BẢO HÀNH & THU CŨ ĐỔI MỚI
// ============================================================

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
}

model Warranty {
  id           String         @id @default(cuid())
  serialNumber String?
  startDate    DateTime
  endDate      DateTime
  status       WarrantyStatus @default(ACTIVE)

  orderItems OrderItem[]
  claims     WarrantyClaim[]
}

enum ClaimStatus {
  RECEIVED
  IN_PROGRESS
  REPAIRED
  REPLACED
  REJECTED
}

model WarrantyClaim {
  id          String      @id @default(cuid())
  warrantyId  String
  issue       String      @db.Text
  status      ClaimStatus @default(RECEIVED)
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?

  warranty Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  @@index([warrantyId])
}

enum TradeInStatus {
  QUOTED
  CONFIRMED
  RECEIVED
  COMPLETED
  CANCELLED
}

model TradeInRequest {
  id             String        @id @default(cuid())
  userId         String
  deviceVariantId String?      // máy cũ tương ứng SP nào trong hệ thống (nếu có)
  deviceInfo     String        // mô tả máy cũ nếu không có trong catalog
  condition      String        // tình trạng máy
  quotedPrice    Decimal       @db.Decimal(12, 0)
  status         TradeInStatus @default(QUOTED)
  createdAt      DateTime      @default(now())

  user           User            @relation(fields: [userId], references: [id])
  deviceVariant  ProductVariant? @relation("TradeInDevice", fields: [deviceVariantId], references: [id])

  @@index([userId])
}

// ============================================================
// 10. HỖ TRỢ KHÁCH HÀNG
// ============================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ORDER_ISSUE
  TECHNICAL_SUPPORT
  COMPLAINT
  WARRANTY
  OTHER
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String?
  fullName  String
  phone     String
  email     String?
  category  TicketCategory
  subject   String
  content   String         @db.Text
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now())

  user    User?            @relation(fields: [userId], references: [id])
  replies TicketReply[]

  @@index([userId])
  @@index([status])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  isStaff   Boolean  @default(false)
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ============================================================
// 11. THÔNG BÁO
// ============================================================

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  SYSTEM
  WARRANTY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// 12. NỘI DUNG TĨNH (CMS) - FAQ, bài viết, banner trang chủ
// ============================================================

model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique // "chinh-sach-bao-hanh", "huong-dan-mua-hang"
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String @id @default(cuid())
  question  String
  answer    String @db.Text
  sortOrder Int    @default(0)
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  position  String   // "home_slider", "home_side"...
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
}

// ============================================================
// 13. NHẬT KÝ HỆ THỐNG (audit log cho admin)
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "UPDATE_PRODUCT", "CANCEL_ORDER"...
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}
